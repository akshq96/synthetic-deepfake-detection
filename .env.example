# Copy to .env at the repo root and adjust. See backend/app/core/config.py
# for the full list of settings and their defaults.

# DATABASE_URL=sqlite:///artifacts/app.db
# APP_MLFLOW_TRACKING_URI=sqlite:///artifacts/mlflow.db

# No checkpoint ships with this repo — set these once you've trained one
# (e.g. via ml/training/train.py or the Synthetic Data Lab) to enable the
# /api/detect endpoints:
# DEFAULT_CHECKPOINT_PATH=/absolute/path/to/artifacts/checkpoints/<run>/best.pt
# DEFAULT_CALIBRATION_PATH=/absolute/path/to/artifacts/checkpoints/<run>/temperature.json
# DEFAULT_MODEL_NAME=efficientnetv2_s
# DEFAULT_IMAGE_SIZE=224
